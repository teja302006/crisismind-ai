# CrisisMind AI - Environment Variables Template
# DO NOT commit actual secrets or keys to version control.

# AI Configuration
# Set to 'gemini' to enable Gemini API. If empty or missing, the platform runs in DEMO AI mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Supabase Configuration
# Supply these if you wish to connect to a live Supabase PostgreSQL database.
# If these are missing or blank, the platform runs in persistent local memory/mock mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
